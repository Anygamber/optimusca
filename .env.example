# Скопируйте в .env и подставьте реальные значения (файл .env в git не попадает).

# --- Google Tag Manager (static front: also set window.GTM_ID in HTML <head>) ---
# Example: GTM-XXXXXXX — used by /js/gtm.js and Ads dataLayer
GTM_ID=
NEXT_PUBLIC_GTM_ID=
GTM_CONTAINER_ID=

# --- Telegram (best-effort notify; form success does not depend on bot) ---
# Токен: @BotFather
# Chat ID: напишите боту → https://api.telegram.org/bot<TOKEN>/getUpdates → message.chat.id
TELEGRAM_BOT_TOKEN=ваш_токен_бота
TELEGRAM_CHAT_ID=ваш_chat_id
TELEGRAM_REQUIRED=false

# --- Tikkurila CRM (Firebase Realtime Database REST) ---
# Корень БД (предпочтительно) ИЛИ URL узла deals — api.py сам вычислит root
CRM_DB_URL=https://crm-tikkurila-default-rtdb.firebaseio.com
CRM_API_URL=https://crm-tikkurila-default-rtdb.firebaseio.com/deals
# Firebase Database secret (Console → Project settings → Service accounts → Database secrets)
# Можно временно оставить пустым, пока rules разрешают auth == null
CRM_API_TOKEN=ваш_firebase_database_secret
CRM_DEFAULT_RESPONSIBLE=Лид с сайта
CRM_DEFAULT_AUTHOR=Сайт Tikkurila

# Очередь Round-Robin посредников (фермеры/дилеры).
# Формат: login:ФИО,login:ФИО
# При первом запуске пишется в Firebase /lead_distribution/partners
# (символ # в ключе Firebase заменяется на _; login в данных остаётся user#25)
CRM_LEAD_PARTNERS=user#25:Хабибуллаева Карина,user#26:Шаусманова Дилноза

# --- Google Ads Offline Conversion Imports (Data Manager Events API) ---
# Master switch (false = no API calls; status webhook still works)
GOOGLE_ADS_ENABLED=true
# Used only for Ads diagnostics (listAccessibleCustomers). OCI uses Data Manager.
GOOGLE_ADS_API_VERSION=v22
# Client Ads account (10 digits, without dashes) — operatingAccount
GOOGLE_ADS_CUSTOMER_ID=4054797246
# MCC → Destination.loginAccount only if this manager owns the client.
# Leave empty when SA has direct client access.
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
# Optional: x-goog-user-project. Leave unset unless SA has serviceusage.consumer on it.
# Enable Data Manager API on the SA's GCP project first:
#   https://console.developers.google.com/apis/api/datamanager.googleapis.com/overview
# GOOGLE_CLOUD_PROJECT=
# EventSource for offline click conversions (WEB | APP | IN_STORE | PHONE | OTHER)
GOOGLE_ADS_EVENT_SOURCE=WEB
# API Center → Developer token (still useful for Ads diagnostics). NEVER leave as "test".
GOOGLE_ADS_DEVELOPER_TOKEN=

# Auth mode: service_account (default when google_key.json exists) | oauth
GOOGLE_ADS_AUTH_MODE=service_account
# Path to SA JSON (relative to app/ or absolute). Default: app/google_key.json
GOOGLE_ADS_SERVICE_ACCOUNT_FILE=google_key.json
# Optional: Workspace user to impersonate (domain-wide delegation)
# GOOGLE_ADS_IMPERSONATE_USER=ads-admin@yourdomain.com

# Legacy Web OAuth (only if GOOGLE_ADS_AUTH_MODE=oauth)
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
REFRESH_TOKEN=
# Conversion actions (Import / Click) — resource names from Google Ads UI.
# OCI bridge uploads ONLY these two (spam/raw are blocked in code):
#   Qualified_Lead | Closed_Deal
# GOOGLE_ADS_CONVERSION_ACTION_SPAM is optional/legacy and never uploaded.
GOOGLE_ADS_CONVERSION_ACTION_QUALIFIED=customers/4054797246/conversionActions/7815437037
GOOGLE_ADS_CONVERSION_ACTION_CLOSED_WON=customers/4054797246/conversionActions/7815489823
GOOGLE_ADS_CONVERSION_ACTION_SPAM=
GOOGLE_ADS_CONV_SPAM=
GOOGLE_ADS_CONV_QUALIFIED=
GOOGLE_ADS_CONV_SALE=
# Closed-won: use lead offerAmount/budget if > 0, else this default
GOOGLE_ADS_DEFAULT_SALE_VALUE=1
# Qualified Lead value when CRM has no amount
GOOGLE_ADS_DEFAULT_QUALIFIED_VALUE=1
# Currency for Data Manager events (UZS or USD)
GOOGLE_ADS_CURRENCY_CODE=UZS
# Runtime log: Website/logs/google_ads.log (created by app/server.py)

# --- Batch OCI sync (POST /admin/push-oci or /api/sync-conversions) ---
# Required to call the admin endpoint (header X-OCI-Token or ?token=)
OCI_SYNC_TOKEN=change_me_long_random_string
# ADMIN_API_TOKEN=  # alias for OCI_SYNC_TOKEN
# Skip leads/conversions older than N days (Google Ads ~90-day lookback)
OCI_MAX_AGE_DAYS=90
